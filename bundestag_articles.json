R_120-26.html","desc":"","date":"2026-08-20T00:00:00+00:00","topics":[],"boost":0,"priority":"","cats":[],"image":"","author":"","cat":"bgh","kind":"press","inst":"bgh","cluster":1},{"id":"5e828186a088","source":"BGH Entscheidungen","title":"1 StR 164/26, Entscheidung vom 07.07.2026","link":"https://www.bundesgerichtshof.de/SharedDocs/Entscheidungen/DE/Strafsenate/1_StS/2026/1_StR_164-26.html","desc":"","date":"2026-08-20T00:00:00+00:00","topics":[],"boost":0,"priority":"","cats":[],"image":"","author":"","cat":"bgh","kind":"press","inst":"bgh","cluster":1},{"id":"0e9446d1f824","source":"BT hib-Meldungen","title":"Haushalt 2027: Weniger Ausgaben für Bildung und Familie","link":"https://www.bundestag.de/presse/hib/kurzmeldungen-1205456","desc":"Bildung, Familie, Senioren, Frauen und Jugend/Gesetzentwurf Für Bildung, Familie, Senioren, Frauen und Jugend sind 2027 rund 15,48 Milliarden Euro vorgesehen. Der Rückgang geht vor allem auf niedrigere Ansätze bei gesetzlichen Familienleistungen zurück.","date":"2026-08-19T16:04:00+00:00","topics":["gesetzgebung","haushalt"],"boost":1,"cat":"bt-allg","cluster":2},{"id":"aad8935185b5","source":"BT hib-Meldungen","title":"201 Milliarden Euro für den Sozialetat 2027","link":"https://www.bundestag.de/presse/hib/kurzmeldungen-1205416","desc":"Arbeit und Soziales/Gesetzentwurf Für den Etat des Bundesministeriums für Arbeit und Soziales sollen 2027 rund 201 Milliarden Euro zur Verfügung stehen. Die Rentenkosten steigen, leicht sinken die Ausgaben für das Grundsicherungsgeld.","date":"2026-08-19T13:48:00+00:00","topics":["soziales","bundesregierung","gesetzgebung","haushalt"],"boost":1,"cat":"bt-allg","cluster":2},{"id":"9362b0eb8ca7","source":"BT hib-Meldungen","title":"Haushalt 2027: Digitaletat steigt auf 1,44 Milliarden Euro","link":"https://www.bundestag.de/presse/hib/kurzmeldungen-1205418","desc":"Digitales und Staatsmodernisierung/Gesetzentwurf Der nun vollständig ausgewiesene Einzelplan bündelt erstmals die Mittel des Digitalministeriums. Im Infrastruktur-Sondervermögen bewirtschaftet das Haus weitere rund 3,75 Milliarden Euro.","date":"2026-08-19T13:48:00+00:00","topics":["digitales","gesetzgebung","haushalt","verteidigung","wirtschaft","bundesregierung"],"boost":1,"cat":"bt-allg","cluster":2},{"id":"2713a7ec7c87","source":"BT hib-Meldungen","title":"Barrierefreie Taxis: Teilhabe nur geringfügig verbessert","link":"https://www.bundestag.de/presse/hib/kurzmeldungen-1205420","desc":"Verkehr/Unterrichtung Die gesellschaftliche Teilhabe von sensorisch oder in ihrer Mobilität eingeschränkten Menschen hat sich der Evaluation des PBefG zufolge nur in sehr geringem Maße verbessert.","date":"2026-08-19T13:48:00+00:00","topics":[],"boost":0,"cat":"bt-allg","cluster":2},{"id":"1ee78e4d5447","source":"BT hib-Meldungen","title":"Linienbedarfsverkehr laut Evaluation erfolgreich integriert","link":"https://www.bundestag.de/presse/hib/kurzmeldungen-1205422","desc":"Verkehr/Unterrichtung Anfang 2025 hatte rund ein Siebtel der Bevölkerung einen direkten Zugang zu einem der 130 Bedarfsverkehrsangebote, heißt es in der Evaluation zur Modernisierung des Personenbeförderungsrechts.","date":"2026-08-19T13:48:00+00:00","topics":[],"boost":1,"cat":"bt-allg","cluster":2},{"id":"2208cd642bf0","source":"BT hib-Meldungen","title":"Urkunde zu Plattformökonomie-Übereinkommen","link":"https://www.bundestag.de/presse/hib/kurzmeldungen-1205406","desc":"Arbeit und Soziales/Unterrichtung Die Bundesregierung hat die Mitteilung über eine angenommene Urkunde eines Übereinkommens der Internationalen Arbeitsorganisation als Unterrichtung vorgelegt.","date":"2026-08-19T10:38:00+00:00","topics":["aussenpolitik","soziales","digitales","bundesregierung"],"boost":0,"cat":"bt-allg","cluster":2},{"id":"56d61dccd403","source":"BT hib-Meldungen","title":"Abgelehnte Förderungen durch Bundesprogramm","link":"https://www.bundestag.de/presse/hib/kurzmeldungen-1205408","desc":"Bildung, Familie, Senioren, Frauen und Jugend/Antwort Die Bundesregierung äußert sich nicht zu einer Entscheidung eines Kreistages in Thüringen, keine Förderungen aus dem Bundesprogramm \"Demokratie leben!\" mehr anzunehmen.","date":"2026-08-19T10:38:00+00:00","topics":["bundesregierung"],"boost":1,"cat":"bt-allg","cluster":2},{"id":"251766ef9356","source":"BT hib-Meldungen","title":"\"Internationalisierung der AfD\" thematisiert","link":"https://www.bundestag.de/presse/hib/kurzmeldungen-1205412","desc":"Inneres/KleineAnfrage \"Internationalisierung der AfD und grenzüberschreitende Vernetzung mit rechtsextremen Parteien und Akteuren\" lautet der Titel einer Kleinen Anfrage der Fraktion Bündnis 90/Die Grünen.","date":"2026-08-19T10:38:00+00:00","topics":["plenum","aussenpolitik"],"boost":0,"cat":"bt-allg","cluster":2},{"id":"9d5d4b8e9052","source":"BT hib-Meldungen","title":"Sicherung der verfassungsmäßigen Ordnung in den Ländern","link":"https://www.bundestag.de/presse/hib/kurzmeldungen-1205410","desc":"Inneres/Antwort Um Vorkehrungen zur Sicherung der verfassungsmäßigen Ordnung in den Ländern geht es in der Antwort der Bundesregierung auf eine Kleine Anfrage der Fraktion Bündnis 90/Die Grünen.","date":"2026-08-19T10:38:00+00:00","topics":["plenum","bundesregierung"],"boost":0,"cat":"bt-allg","cluster":2},{"id":"8e5ec857b3fd","source":"BT Drucksachen","title":"21/7600: Unterrichtung 19. Plenartagung der Parlamentarischen Versammlung der Union für den Mittelmeerraum vom 4. bis 5. Juli 2026 in Kairo, Ägypten (PDF)","link":"https://dserver.bundestag.de/btd/21/076/2107600.pdf","desc":"","date":"2026-08-19T10:00:00+00:00","topics":[],"boost":0,"priority":"","cats":[],"image":"","author":"Parlamentsdokumentation (parlamentsdokumentation@bundestag.de)","cat":"bt-allg","kind":"press","inst":"bundestag","cluster":1},{"id":"fc789176a794","source":"BT Drucksachen","title":"21/7680: Unterrichtung Übersicht nach § 7 Absatz 2 des Bundes-Klimaschutzgesetzes zu Durchführungsvorschriften zur Europäischen Klimaschutzverordnung (PDF)","link":"https://dserver.bundestag.de/btd/21/076/2107680.pdf","desc":"","date":"2026-08-19T10:00:00+00:00","topics":["umwelt","gesetzgebung"],"boost":1,"cat":"bt-allg","cluster":1},{"id":"26d1288ef1f1","source":"BT Drucksachen","title":"21/7658: Kleine Anfrage Deutschlands Rolle in den Vereinten Nationen (Nachfrage zur Antwort der Bundesregierung auf die Kleine Anfrage auf Bundestagsdrucksache 21/7343) (PDF)","link":"https://dserver.bundestag.de/btd/21/076/2107658.pdf","desc":"","date":"2026-08-19T10:00:00+00:00","topics":["gesetzgebung","plenum","bundesregierung"],"boost":0,"cat":"bt-allg","cluster":1},{"id":"d711dd72bc7e","source":"BT Drucksachen","title":"21/7646: Kleine Anfrage Grundwasser in Deutschland - Messstellenabdeckung, Datenqualität, regionale Nutzungskonkurrenzen und politische Einflussfaktoren (PDF)","link":"https://dserver.bundestag.de/btd/21/076/2107646.pdf","desc":"","date":"2026-08-19T10:00:00+00:00","topics":["plenum"],"boost":0,"cat":"bt-allg","cluster":1},{"id":"3f4b85940831","source":"BT hib-Meldungen","title":"Anforderungen zur Haltung gefährlicher Tiere","link":"https://www.bundestag.de/presse/hib/kurzmeldungen-1205390","desc":"Landwirtschaft, Ernährung und Heimat/Antwort Die Bundesregierung sieht derzeit keinen Bedarf für weitere bundeseinheitliche Mindeststandards zur Haltung gefährlicher Tiere. Das antwortet sie auf AfD-Anfrage.","date":"2026-08-19T09:46:00+00:00","topics":["plenum","wirtschaft","bundesregierung"],"boost":0,"cat":"bt-allg","cluster":2},{"id":"be83b40111eb","source":"BT hib-Meldungen","title":"Umsatzsteuersatz für veterinärmedizinische Leistungen bleibt","link":"https://www.bundestag.de/presse/hib/kurzmeldungen-1205394","desc":"Finanzen/Antwort Eine Absenkung des Umsatzsteuersatzes auf veterinärmedizinische Leistungen ist nach geltendem Unionsrecht nicht zulässig. Das schreibt die Bundesregierung in ihrer Antwort auf AfD-Anfrage.","date":"2026-08-19T09:46:00+00:00","topics":["plenum","haushalt","bundesregierung"],"boost":0,"cat":"bt-allg","cluster":2},{"id":"7060dc0bd05f","source":"BT hib-Meldungen","title":"Maßnahmen gegen hohe Spritpreise","link":"https://www.bundestag.de/presse/hib/kurzmeldungen-1205392","desc":"Finanzen/Antwort Über weitere Entlastungen bei hohen Kraftstoffpreisen will die Bundesregierung abhängig von der Entwicklung der Energiepreise entscheiden. Das antwortet sie auf AfD-Anfrage.","date":"2026-08-19T09:46:00+00:00","topics":["plenum","haushalt","bundesregierung"],"boost":0,"cat":"bt-allg","cluster":2},{"id":"67c9f3fec00a","source":"BT hib-Meldungen","title":"Legale Wirtschaftsstrukturen und Organisierte Kriminalität","link":"https://www.bundestag.de/presse/hib/kurzmeldungen-1205398","desc":"Finanzen/KleineAnfrage Die AfD-Fraktion erkundigt sich mittels einer Kleinen Anfrage nach der \"Nutzung legaler Wirtschaftsstrukturen durch die Organisierte Kriminalität in Deutschland\".","date":"2026-08-19T09:46:00+00:00","topics":["plenum","haushalt","wirtschaft","innenpolitik"],"boost":0,"cat":"bt-allg","cluster":2},{"id":"09573a814172","source":"BT hib-Meldungen","title":"Haushalt 2027: Verkehr bleibt größter Investitionsetat","link":"https://www.bundestag.de/presse/hib/kurzmeldungen-1205386","desc":"Verkehr/Gesetzentwurf Der Einzelplan 12 im Entwurf des Haushaltsgesetzes 2027 sieht Ausgaben in Höhe von 26,43 Milliarden Euro vor - etwa weniger als für 2026 (27,9 Milliarden Euro).","date":"2026-08-19T09:46:00+00:00","topics":["gesetzgebung","haushalt"],"boost":1,"cat":"bt-allg","cluster":2},{"id":"9f8d79d09a5d","source":"BT hib-Meldungen","title":"Externe Kommunikationsberater im BMWE","link":"https://www.bundestag.de/presse/hib/kurzmeldungen-1205396","desc":"Wirtschaft und Energie/Antwort Die Bundesregierung antwortet auf eine Kleine Anfrage der Fraktion Die Linke zur externen Kommunikationsberatung im Bundesministerium für Wirtschaft und Energie.","date":"2026-08-19T09:46:00+00:00","topics":["bundesregierung","plenum","wirtschaft"],"boost":0,"cat":"bt-allg","cluster":2},{"id":"758f