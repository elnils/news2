al physics-based robot.","date":"2018-11-07T08:00:00+00:00","topics":[],"cat":"en-ai","boost":0,"cluster":null,"access":"unknown","_set":null},{"id":"d4278b7481fc","source":"LReg Bayern","title":"Söder als Ministerpräsident wiedergewählt - mindestens einer stimmte nicht für ihn","link":"https://news.google.?oc=5","desc":"Söder als Ministerpräsident wiedergewählt - mindestens einer stimmte nicht für ihn Merkur","date":"2018-11-07T08:00:00+00:00","topics":[],"cat":"by","boost":0,"cluster":1,"access":"unknown","_set":null},{"id":"63548bb3e0b8","source":"EUR-Lex OJ-L","title":"Directive - 2009/48 - EN - EUR-Lex","link":"https://news.google.com/rss/articles/CBMiXEFVX3lxTE4wa1V2Wm1MWlFUQ0dMZTFSb214SGZuRjdYU01NWWwwY2cyejUtVElkNDN0eldRN3FYWXgxQWFLNXQyemJjLUZvRjFnNjFYRVl2MWFtS1p3N2poaXNX?oc=5","desc":"Directive - 2009/48 - EN EUR-Lex","date":"2018-11-06T12:29:57+00:00","topics":[],"cat":"eurlex","boost":0,"cluster":1,"access":"unknown","_set":null},{"id":"a85ab4ade444","source":"EUR-Lex OJ-L","title":"Directive - 2009/48 - EN - CareerOneStop","link":"https://news.google.com/rss/articles/CBMiXEFVX3lxTE4wa1V2Wm1MWlFUQ0dMZTFSb214SGZuRjdYU01NWWwwY2cyejUtVElkNDN0eldRN3FYWXgxQWFLNXQyemJjLUZvRjFnNjFYRVl2MWFtS1p3N2poaXNX?oc=5","desc":"Directive - 2009/48 - EN CareerOneStop","date":"2018-11-06T12:29:57+00:00","topics":[],"cat":"eurlex","boost":0,"cluster":1,"access":"unknown","_set":null},{"id":"4ee7865e2755","source":"EUR-Lex OJ-L","title":"Directive - 2009/48 - EN - eur-lex.europa.eu","link":"https://news.google.com/rss/articles/CBMiXEFVX3lxTE4wa1V2Wm1MWlFUQ0dMZTFSb214SGZuRjdYU01NWWwwY2cyejUtVElkNDN0eldRN3FYWXgxQWFLNXQyemJjLUZvRjFnNjFYRVl2MWFtS1p3N2poaXNX?oc=5","desc":"Directive - 2009/48 - EN eur-lex.europa.eu","date":"2018-11-06T12:29:57+00:00","topics":[],"cat":"eurlex","boost":0,"cluster":1,"access":"unknown","_set":null},{"id":"aebdc1c86bd6","source":"EUR-Lex OJ-L","title":"Directive - 2005/36 - EN - eur-lex.europa.eu","link":"https://news.google.com/rss/articles/CBMiXEFVX3lxT